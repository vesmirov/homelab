# Copy to .env next to docker-compose.yml. Never commit .env.

DOMAIN=https://vault.example.com
VAULT_HOST=vault.example.com

# Kept enabled because Send recipients open a web vault page.
# Never type the master password into a browser on this domain. Native clients only.
WEB_VAULT_ENABLED=true

# Empty or absent: admin panel disabled.
# The panel is never reachable from the internet, Caddy answers 404 on /admin.
# To use it, set an argon2 hash here and open an SSH tunnel to 127.0.0.1:8081.
#   docker run --rm -it vaultwarden/server:latest /vaultwarden hash --preset owasp
# Keep the single quotes, otherwise compose interpolates the $ signs.
# ADMIN_TOKEN='$argon2id$v=19$m=19456,t=2,p=1$...'

SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false

LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=10
ADMIN_RATELIMIT_SECONDS=300

# Per-user limits, in KB
USER_ATTACHMENT_LIMIT=2097152
USER_SEND_LIMIT=1048576

# Caddy passes the client address in this header
IP_HEADER=X-Real-IP

# Let's Encrypt account email, used by Caddy
ACME_EMAIL=

# Mail goes through an external relay only. Fill in when the SMTP token exists.
# SMTP_HOST=smtp.protonmail.ch
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
