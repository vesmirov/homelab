#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

MOUNT=/mnt/vault
STACK=/mnt/vault/stack
DOMAIN=$(grep -E "^VAULT_HOST=" "$STACK/.env" | cut -d= -f2)

if mountpoint -q "$MOUNT"; then
    echo -e "${GREEN}[OK]${NC} $MOUNT is mounted"
else
    echo -e "${RED}[ERROR]${NC} $MOUNT is not mounted"
    exit 1
fi

echo ""
cd "$STACK" && docker compose ps --format "table {{.Name}}\t{{.Status}}"

echo ""
LOCAL_CODE=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:8081/alive 2>/dev/null)
if [ "$LOCAL_CODE" = "200" ]; then
    echo -e "${GREEN}[OK]${NC} vaultwarden responds locally"
else
    echo -e "${RED}[ERROR]${NC} vaultwarden local check failed (code: $LOCAL_CODE)"
fi

PUBLIC_CODE=$(curl -s -o /dev/null -w "%{http_code}" "https://$DOMAIN/alive" 2>/dev/null)
if [ "$PUBLIC_CODE" = "200" ]; then
    echo -e "${GREEN}[OK]${NC} https://$DOMAIN responds"
else
    echo -e "${RED}[ERROR]${NC} https://$DOMAIN check failed (code: $PUBLIC_CODE)"
fi

ROOT_CODE=$(curl -s -o /dev/null -w "%{http_code}" "https://$DOMAIN/" 2>/dev/null)
if [ "$ROOT_CODE" = "200" ]; then
    echo -e "${GREEN}[OK]${NC} web vault responds"
else
    echo -e "${RED}[ERROR]${NC} web vault returned $ROOT_CODE, expected 200"
fi

ADMIN_CODE=$(curl -s -o /dev/null -w "%{http_code}" "https://$DOMAIN/admin" 2>/dev/null)
if [ "$ADMIN_CODE" = "404" ]; then
    echo -e "${GREEN}[OK]${NC} /admin is closed"
else
    echo -e "${RED}[ERROR]${NC} /admin returned $ADMIN_CODE, expected 404"
fi
