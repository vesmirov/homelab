#!/bin/bash
set -euo pipefail

IMAGE=/opt/vault.img
NAME=vault
MOUNT=/mnt/vault
STACK=/mnt/vault/stack

if [ "$(id -u)" -ne 0 ]; then
    echo "run with sudo" >&2
    exit 1
fi

if [ ! -e "/dev/mapper/$NAME" ]; then
    cryptsetup open "$IMAGE" "$NAME"
fi

if ! mountpoint -q "$MOUNT"; then
    mount "/dev/mapper/$NAME" "$MOUNT"
fi

if ! mountpoint -q "$MOUNT"; then
    echo "$MOUNT is not mounted" >&2
    exit 1
fi

cd "$STACK"
docker compose up -d
docker compose ps
