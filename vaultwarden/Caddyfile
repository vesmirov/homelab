{
	email {$ACME_EMAIL}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	servers {
		protocols h1 h2
	}
}

{$VAULT_HOST} {
	encode zstd gzip
	log

	tls {
		protocols tls1.3
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	handle /admin* {
		respond 404
	}

	handle {
		reverse_proxy vaultwarden:80 {
			header_up X-Real-IP {remote_host}
		}
	}
}
