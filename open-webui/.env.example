# Open WebUI environment variables
# Copy this file to .env and fill in the values

# Ollama backend (external Ollama instance, e.g. reachable over Tailscale)
OLLAMA_BASE_URL=http://localhost:11434

# WebUI secret key (generate with: openssl rand -hex 32)
WEBUI_SECRET_KEY=

# Allowed CORS origins (semicolon-separated list of full origins)
CORS_ALLOW_ORIGIN=http://localhost:3000

# Jupyter code execution / interpreter token (generate with: openssl rand -hex 32)
JUPYTER_TOKEN=
